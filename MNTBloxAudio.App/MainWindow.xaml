<Window x:Class="MNTBloxAudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:core="clr-namespace:MNTBloxAudio.Core.Models;assembly=MNTBloxAudio.Core"
        mc:Ignorable="d"
        Title="MNTBloxAudio"
        Width="1300"
        Height="860"
        MinWidth="1040"
        MinHeight="720"
        Background="{StaticResource WindowBrush}"
        FontFamily="Segoe UI Variable Text"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="34">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <MediaElement x:Name="PreviewPlayer"
                      Width="0"
                      Height="0"
                      Opacity="0"
                      LoadedBehavior="Play"
                      UnloadedBehavior="Stop"
                      Source="{Binding PreviewAudioSource}"
                      MediaOpened="PreviewPlayer_OnMediaOpened"
                      MediaEnded="PreviewPlayer_OnMediaEnded"
                      MediaFailed="PreviewPlayer_OnMediaFailed" />

        <TextBlock Grid.Row="0"
                   Style="{StaticResource WindowTitleTextStyle}"
                   Text="MINTILER'S ROBLOX AUDIO REPLACER"
                   TextWrapping="Wrap" />

        <TabControl Grid.Row="2"
                    Margin="0,26,0,0">
            <TabItem Header="MY AUDIO">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.1*" />
                        <ColumnDefinition Width="0.95*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Margin="0,0,18,0"
                            Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="2.2*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Style="{StaticResource PanelHeadingTextStyle}"
                                           VerticalAlignment="Center"
                                           Text="MY AUDIO" />

                                <Grid Grid.Column="1"
                                      Margin="20,0,14,0"
                                      VerticalAlignment="Center">
                                    <TextBox Margin="0"
                                             Text="{Binding RuleSearchQuery, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>

                                <Button Grid.Column="2"
                                        Width="58"
                                        Height="46"
                                        Margin="0,0,0,12"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Content="F"
                                        Command="{Binding ToggleRuleFilterCommand}" />
                            </Grid>

                            <WrapPanel Grid.Row="1"
                                       HorizontalAlignment="Right"
                                       Margin="0,10,0,16">
                                <Button Content="Add"
                                        Command="{Binding AddRuleCommand}" />
                                <Button Content="Apply All"
                                        Command="{Binding ApplyAllRulesCommand}" />
                                <Button Content="Remove"
                                        Command="{Binding RemoveSelectedRuleCommand}" />
                            </WrapPanel>

                            <ScrollViewer Grid.Row="2"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ListBox ItemsSource="{Binding VisibleRules}"
                                         SelectedItem="{Binding SelectedRule}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type core:ReplacementRule}">
                                            <Border Style="{StaticResource RuleTileBorderStyle}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Style="{StaticResource CardTitleTextStyle}"
                                                               Text="{Binding Name}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Grid.Row="1"
                                                               Margin="0,2,0,0"
                                                               Style="{StaticResource TinyLabelTextStyle}"
                                                               Text="{Binding SourceTypeDisplay}" />

                                                    <StackPanel Grid.Row="2"
                                                                Margin="0,30,0,0"
                                                                VerticalAlignment="Top">
                                                        <TextBlock Foreground="{StaticResource BrightTextBrush}"
                                                                   FontSize="18"
                                                                   Text="{Binding AssetIdPattern, StringFormat=#: {0}}" />
                                                        <TextBlock Margin="0,8,0,0"
                                                                   Style="{StaticResource TinyLabelTextStyle}"
                                                                   Text="{Binding FileNameDisplay}"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>

                                                    <DockPanel Grid.Row="3"
                                                               LastChildFill="False">
                                                        <StackPanel DockPanel.Dock="Left">
                                                            <TextBlock Style="{StaticResource TinyLabelTextStyle}"
                                                                       Text="{Binding SourceAssetSizeDisplay}" />
                                                            <TextBlock Style="{StaticResource TinyLabelTextStyle}"
                                                                       Text="{Binding ReplacementFileSizeDisplay}" />
                                                        </StackPanel>
                                                        <Border DockPanel.Dock="Right"
                                                                Tag="{Binding VisualDotState}"
                                                                Style="{StaticResource IndicatorBorderStyle}" />
                                                    </DockPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1"
                            Style="{StaticResource CardBorderStyle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           HorizontalAlignment="Center"
                                           Style="{StaticResource PanelHeadingTextStyle}"
                                           Text="EDIT" />

                                <Border Grid.Row="1"
                                        Margin="0,22,0,18"
                                        Padding="18"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource CardBorderBrush}"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardTitleTextStyle}"
                                                   Text="{Binding SelectedRule.Name, TargetNullValue=SONG 1}" />
                                        <TextBlock Margin="0,2,0,0"
                                                   Style="{StaticResource TinyLabelTextStyle}"
                                                   Text="{Binding SelectedRule.SourceTypeDisplay, TargetNullValue=ARTISTS}" />
                                        <TextBlock Margin="0,26,0,0"
                                                   Foreground="{StaticResource BrightTextBrush}"
                                                   FontSize="15"
                                                   Text="{Binding SelectedRule.FileNameDisplay, TargetNullValue=UPLOADED BY: Name}" />
                                        <TextBlock Margin="0,8,0,0"
                                                   Foreground="{StaticResource BrightTextBrush}"
                                                   FontSize="16"
                                                   Text="{Binding SelectedRule.AssetIdPattern, TargetNullValue=XXXXXX}" />
                                    </StackPanel>
                                </Border>

                                <WrapPanel Grid.Row="2"
                                           Margin="0,0,0,8">
                                    <Button Content="PLAY"
                                            Command="{Binding PlaySelectedRuleCommand}" />
                                    <Button Content="STOP"
                                            Command="{Binding StopRulePreviewCommand}" />
                                    <Button Style="{StaticResource AccentButtonStyle}"
                                            Content="TOGGLE"
                                            Command="{Binding SaveAndApplySelectedRuleCommand}" />
                                </WrapPanel>

                                <CheckBox Grid.Row="3"
                                          Margin="0,4,0,10"
                                          IsChecked="{Binding SelectedRule.IsEnabled}"
                                          Content="Enable Replacement" />

                                <TextBlock Grid.Row="4"
                                           Style="{StaticResource TinyLabelTextStyle}"
                                           Text="Name" />
                                <TextBox Grid.Row="4"
                                         Margin="0,22,0,12"
                                         Text="{Binding SelectedRule.Name, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="5"
                                           Style="{StaticResource TinyLabelTextStyle}"
                                           Text="Exact Roblox asset ID" />
                                <TextBox Grid.Row="5"
                                         Margin="0,22,0,12"
                                         Text="{Binding SelectedRule.AssetIdPattern, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="6"
                                           Style="{StaticResource TinyLabelTextStyle}"
                                           Text="Replacement file, direct URL, or 6-letter code" />
                                <DockPanel Grid.Row="6"
                                           Margin="0,22,0,18"
                                           LastChildFill="True">
                                    <Button DockPanel.Dock="Right"
                                            Width="124"
                                            Margin="12,0,0,0"
                                            Content="Browse File"
                                            Command="{Binding BrowseSelectedRuleCommand}" />
                                    <TextBox Text="{Binding SelectedRule.FilePath, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>

                                <UniformGrid Grid.Row="7"
                                             Margin="0,0,0,18"
                                             Columns="2">
                                    <Border Margin="0,0,8,0"
                                            Padding="12"
                                            Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource CardBorderBrush}"
                                            BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource TinyLabelTextStyle}"
                                                       Text="Roblox cache" />
                                            <TextBlock Margin="0,12,0,0"
                                                       Foreground="{StaticResource BrightTextBrush}"
                                                       FontSize="18"
                                                       Text="{Binding SelectedRule.SourceAssetSizeDisplay}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Margin="8,0,0,0"
                                            Padding="12"
                                            Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource CardBorderBrush}"
                                            BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource TinyLabelTextStyle}"
                                                       Text="Replacement" />
                                            <TextBlock Margin="0,12,0,0"
                                                       Foreground="{StaticResource BrightTextBrush}"
                                                       FontSize="18"
                                                       Text="{Binding SelectedRule.ReplacementFileSizeDisplay}" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <Button Grid.Row="7"
                                        Margin="0,108,0,0"
                                        HorizontalAlignment="Center"
                                        Width="190"
                                        Height="56"
                                        Content="RESET"
                                        Command="{Binding RefreshCommand}" />
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="UPLOADING">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.18*" />
                        <ColumnDefinition Width="0.92*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Margin="0,0,18,0"
                            Style="{StaticResource CardBorderStyle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Style="{StaticResource PanelHeadingTextStyle}"
                                           Text="UPLOADING" />
                                <TextBlock Margin="0,18,0,0"
                                           Style="{StaticResource TinyLabelTextStyle}"
                                           Text="Device ID" />
                                <DockPanel Margin="0,8,0,12"
                                           LastChildFill="True">
                                    <Button DockPanel.Dock="Right"
                                            Width="88"
                                            Margin="12,0,0,0"
                                            Content="COPY"
                                            Command="{Binding CopyDeviceIdCommand}" />
                                    <TextBox Text="{Binding DeviceId}"
                                             IsReadOnly="True" />
                                </DockPanel>

                                <TextBlock Style="{StaticResource TinyLabelTextStyle}"
                                           Text="Song index base URL" />
                                <TextBox Text="{Binding SongIndexBaseUrl, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Style="{StaticResource TinyLabelTextStyle}"
                                           Text="Source Roblox sound ID" />
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right"
                                            Width="104"
                                            Margin="12,0,0,0"
                                            Content="AUTOFILL"
                                            Command="{Binding AutofillUploadFromRobloxSoundIdCommand}" />
                                    <TextBox Text="{Binding UploadRobloxSoundId, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>

                                <TextBlock Style="{StaticResource TinyLabelTextStyle}"
                                           Text="Linked Roblox sound ID" />
                                <TextBox Text="{Binding UploadLinkedAssetId, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Style="{StaticResource TinyLabelTextStyle}"
                                           Text="Direct audio URL" />
                                <TextBox Text="{Binding UploadAudioUrl, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Style="{StaticResource TinyLabelTextStyle}"
                                           Text="Song name" />
                                <TextBox Text="{Binding UploadSongName, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Style="{StaticResource TinyLabelTextStyle}"
                                           Text="Artist" />
                                <TextBox Text="{Binding UploadArtist, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Style="{StaticResource TinyLabelTextStyle}"
                                           Text="Uploader name" />
                                <TextBox Text="{Binding UploadUploaderName, UpdateSourceTrigger=PropertyChanged}" />

                                <Border Margin="0,8,0,16"
                                        Padding="12"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource CardBorderBrush}"
                                        BorderThickness="1">
                                    <TextBlock Text="{Binding UploadStatusText}"
                                               TextWrapping="Wrap" />
                                </Border>

                                <WrapPanel>
                                    <Button Content="PREVIEW"
                                            Command="{Binding PreviewTypedAudioCommand}" />
                                    <Button Style="{StaticResource AccentButtonStyle}"
                                            Content="SUBMIT"
                                            Command="{Binding UploadAudioCommand}" />
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Column="1"
                            Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Style="{StaticResource PanelHeadingTextStyle}"
                                       HorizontalAlignment="Center"
                                       Text="MY SUBMISSIONS" />

                            <ListBox Grid.Row="1"
                                     Margin="0,20,0,18"
                                     ItemsSource="{Binding UploadedSongs}"
                                     SelectedItem="{Binding SelectedUploadedSong}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type core:UploadedSongRecord}">
                                        <Border Style="{StaticResource LibraryTileBorderStyle}">
                                            <DockPanel LastChildFill="True">
                                                <StackPanel DockPanel.Dock="Left">
                                                    <TextBlock Style="{StaticResource CardTitleTextStyle}"
                                                               FontSize="18"
                                                               Text="{Binding SummaryDisplay}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Margin="0,6,0,0"
                                                               Style="{StaticResource TinyLabelTextStyle}"
                                                               Text="{Binding Code, StringFormat=#: {0}}" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               Style="{StaticResource TinyLabelTextStyle}"
                                                               Text="{Binding LinkedAssetIdDisplay}" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               Style="{StaticResource TinyLabelTextStyle}"
                                                               Text="{Binding UploaderDisplay}" />
                                                </StackPanel>
                                                <Border DockPanel.Dock="Right"
                                                        Tag="{Binding StatusTone}"
                                                        Style="{StaticResource IndicatorBorderStyle}" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border Grid.Row="2"
                                    Padding="14"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitleTextStyle}"
                                               FontSize="18"
                                               Text="{Binding SelectedUploadedSong.SummaryDisplay, TargetNullValue=NO UPLOAD SELECTED}" />
                                    <TextBlock Margin="0,8,0,0"
                                               Text="{Binding PreviewStatusText}"
                                               TextWrapping="Wrap" />
                                    <WrapPanel Margin="0,14,0,0">
                                        <Button Content="PLAY"
                                                Command="{Binding PreviewSelectedUploadCommand}" />
                                        <Button Content="STOP"
                                                Command="{Binding StopPreviewCommand}" />
                                        <Button Content="DELETE"
                                                Command="{Binding DeleteSelectedUploadCommand}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="SONG INDEX">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.28*" />
                        <ColumnDefinition Width="0.82*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Margin="0,0,18,0"
                            Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.35*" />
                                    <ColumnDefinition Width="2.15*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Style="{StaticResource PanelHeadingTextStyle}"
                                           VerticalAlignment="Center"
                                           Text="SONG INDEX" />

                                <TextBox Grid.Column="1"
                                         Margin="18,0,12,12"
                                         Text="{Binding SongSearchQuery, UpdateSourceTrigger=PropertyChanged}" />

                                <Button Grid.Column="2"
                                        Width="104"
                                        Height="46"
                                        Margin="0,0,0,12"
                                        Content="SEARCH"
                                        Command="{Binding SearchSongsCommand}" />
                            </Grid>

                            <WrapPanel Grid.Row="1"
                                       HorizontalAlignment="Right"
                                       Margin="0,0,0,14">
                                <Button Content="ALL SONGS"
                                        Command="{Binding LoadAllSongsCommand}" />
                            </WrapPanel>

                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Style="{StaticResource TinyLabelTextStyle}"
                                           Text="{Binding SongSearchStatusText}"
                                           TextWrapping="Wrap" />

                                <ListBox Grid.Row="1"
                                         Margin="0,16,0,0"
                                         ItemsSource="{Binding SongSearchResults}"
                                         SelectedItem="{Binding SelectedSongSearchResult}"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type core:SongIndexEntry}">
                                            <Border Style="{StaticResource LibraryTileBorderStyle}">
                                                <DockPanel LastChildFill="True">
                                                    <StackPanel DockPanel.Dock="Left">
                                                        <TextBlock Style="{StaticResource CardTitleTextStyle}"
                                                                   FontSize="18"
                                                                   Text="{Binding SongName}"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Margin="0,6,0,0"
                                                                   Style="{StaticResource TinyLabelTextStyle}"
                                                                   Text="{Binding Artist}" />
                                                        <TextBlock Margin="0,4,0,0"
                                                                   Style="{StaticResource TinyLabelTextStyle}"
                                                                   Text="{Binding Code, StringFormat=#: {0}}" />
                                                        <TextBlock Margin="0,4,0,0"
                                                                   Style="{StaticResource TinyLabelTextStyle}"
                                                                   Text="{Binding LinkedAssetIdDisplay}" />
                                                    </StackPanel>
                                                    <Border DockPanel.Dock="Right"
                                                            Tag="{Binding StatusTone}"
                                                            Style="{StaticResource IndicatorBorderStyle}" />
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1"
                            Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       HorizontalAlignment="Center"
                                       Style="{StaticResource PanelHeadingTextStyle}"
                                       Text="EDIT" />

                            <Border Grid.Row="1"
                                    Margin="0,22,0,18"
                                    Padding="18"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitleTextStyle}"
                                               Text="{Binding SelectedSongSearchResult.SongName, TargetNullValue=SONG 1}" />
                                    <TextBlock Margin="0,2,0,0"
                                               Style="{StaticResource TinyLabelTextStyle}"
                                               Text="{Binding SelectedSongSearchResult.Artist, TargetNullValue=ARTISTS}" />
                                    <TextBlock Margin="0,26,0,0"
                                               Foreground="{StaticResource BrightTextBrush}"
                                               FontSize="15"
                                               Text="{Binding SelectedSongSearchResult.UploaderDisplay, TargetNullValue=UPLOADED BY: Name}" />
                                    <TextBlock Margin="0,8,0,0"
                                               Foreground="{StaticResource BrightTextBrush}"
                                               FontSize="16"
                                               Text="{Binding SelectedSongSearchResult.Code, TargetNullValue=XXXXXX}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2"
                                    Margin="0,0,0,18"
                                    Padding="14"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TinyLabelTextStyle}"
                                               Text="{Binding PreviewStatusText}" />
                                    <WrapPanel Margin="0,14,0,0">
                                        <Button Content="PLAY"
                                                Command="{Binding PreviewSelectedSongSearchResultCommand}" />
                                        <Button Content="COPY"
                                                Command="{Binding CopySelectedSongCodeCommand}" />
                                        <Button Content="STOP"
                                                Command="{Binding StopPreviewCommand}" />
                                        <Button Style="{StaticResource AccentButtonStyle}"
                                                Content="USE CODE"
                                                Command="{Binding UseSelectedSongCodeCommand}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Grid.Row="3"
                                       Style="{StaticResource TinyLabelTextStyle}"
                                       Text="Using a song code in a rule can fill both the source reference and its linked Roblox asset when the index entry already has one."
                                       TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="ADVANCED">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1.05*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Margin="0,0,0,18"
                            Style="{StaticResource CardBorderStyle}">
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left"
                                       Style="{StaticResource PanelHeadingTextStyle}"
                                       Text="ADVANCED" />
                            <WrapPanel DockPanel.Dock="Right">
                                <CheckBox VerticalAlignment="Center"
                                          IsChecked="{Binding UseDarkMode}"
                                          Content="Dark mode" />
                                <CheckBox VerticalAlignment="Center"
                                          IsChecked="{Binding AutoApplyCacheReplacements}"
                                          Content="Auto-apply" />
                                <Button Content="PREPARE"
                                        Command="{Binding PrepareRuleAssetsCommand}" />
                                <Button Content="SAVE"
                                        Command="{Binding SaveConfigurationCommand}" />
                            </WrapPanel>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1"
                            Margin="0,0,0,18"
                            Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Style="{StaticResource PanelHeadingTextStyle}"
                                       FontSize="22"
                                       Text="CACHED SOUNDS" />

                            <DataGrid Grid.Row="1"
                                      Margin="0,16,0,0"
                                      ItemsSource="{Binding CachedSoundFiles}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      GridLinesVisibility="Horizontal"
                                      BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="File"
                                                        Binding="{Binding FileName}"
                                                        Width="1.5*" />
                                    <DataGridTextColumn Header="Cache KB"
                                                        Binding="{Binding LengthDisplay}"
                                                        Width="100" />
                                    <DataGridTextColumn Header="Asset ID"
                                                        Binding="{Binding MatchedAssetId}"
                                                        Width="120" />
                                    <DataGridTextColumn Header="Rule"
                                                        Binding="{Binding MatchedRuleName}"
                                                        Width="1.1*" />
                                    <DataGridTextColumn Header="State"
                                                        Binding="{Binding StatusText}"
                                                        Width="110" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Style="{StaticResource PanelHeadingTextStyle}"
                                       FontSize="22"
                                       Text="ACTIVITY" />

                            <ListBox Grid.Row="1"
                                     Margin="0,16,0,0"
                                     ItemsSource="{Binding Activity}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type core:ActivityLogEntry}">
                                        <Border Margin="0,0,0,10"
                                                Padding="12"
                                                Background="{StaticResource SurfaceAltBrush}"
                                                BorderBrush="{StaticResource CardBorderBrush}"
                                                BorderThickness="1">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left"
                                                           Foreground="{StaticResource BrightTextBrush}"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding Category}" />
                                                <TextBlock DockPanel.Dock="Right"
                                                           Style="{StaticResource TinyLabelTextStyle}"
                                                           Text="{Binding Timestamp, StringFormat={}{0:hh:mm:ss tt}}" />
                                                <TextBlock Margin="0,22,0,0"
                                                           Text="{Binding Message}"
                                                           TextWrapping="Wrap" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
