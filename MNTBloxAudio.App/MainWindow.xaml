<Window x:Class="MNTBloxAudio.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="MNTBloxAudio" Width="1120" Height="820" MinWidth="860" MinHeight="650" Background="{StaticResource Background}" Foreground="#EDF3FA" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" Closing="Window_Closing">
 <Grid Margin="32,24" Background="{StaticResource Background}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,24">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#x25CF;" Foreground="{StaticResource Accent}" Margin="0,0,8,0"/><TextBlock Text="{Binding MonitorStatus}" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel>
   <StackPanel Orientation="Horizontal"><TextBlock Text="MNT" FontSize="23" FontWeight="Bold" Foreground="{StaticResource Accent}"/><TextBlock Text="BloxAudio" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="{Binding VersionLabel}" Margin="12,9,0,0" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel>
  </DockPanel>
  <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTab}" Background="Transparent" BorderThickness="0" SelectionChanged="Tabs_SelectionChanged">
   <TabItem Header="Search">
    <Grid Margin="0,24,0,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Margin="0,4,0,24" MaxWidth="720" HorizontalAlignment="Center">
      <TextBlock Text="Find your next sound." FontSize="36" FontWeight="SemiBold" HorizontalAlignment="Center"/>
      <TextBlock Text="Search it. Store it. Make it yours." Foreground="{StaticResource Muted}" FontSize="16" HorizontalAlignment="Center" Margin="0,8,0,24"/>
      <Border Background="#1A232D" BorderBrush="#3B504B" BorderThickness="1" CornerRadius="28" Padding="8" MaxWidth="670">
       <Border.Style><Style TargetType="Border"><Setter Property="Width" Value="670"/><Style.Triggers><DataTrigger Binding="{Binding HasSelectedSong}" Value="True"><Setter Property="Width" Value="400"/></DataTrigger></Style.Triggers></Style></Border.Style>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox x:Name="SearchInput" Text="{Binding SongSearchQuery, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search by song, artist, Roblox ID, or code" FontSize="18" Background="Transparent" BorderThickness="0" Padding="16,12" KeyDown="Search_KeyDown"/>
        <TextBlock Text="Song, artist, Roblox ID, or code" IsHitTestVisible="False" Foreground="{StaticResource Muted}" Margin="16,0,8,0" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SongSearchQuery}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        <Button Grid.Column="1" Content="Search" Command="{Binding SearchSongsCommand}" Style="{StaticResource Primary}" Padding="26,12"/>
       </Grid>
      </Border>
      <TextBlock Text="{Binding SearchStatus}" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
      <ProgressBar Height="2" Margin="24,8,24,0" IsIndeterminate="True" Visibility="{Binding SearchSongsCommand.IsRunning, Converter={StaticResource BoolVisibility}}"/>
     </StackPanel>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <ListBox ItemsSource="{Binding SongSearchResults}" SelectedItem="{Binding SelectedSong}" AutomationProperties.Name="Search results">
       <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding SongName}" FontWeight="SemiBold" FontSize="17"/><TextBlock Text="{Binding Artist}" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Code}" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="18,0,0,0"/></Grid></DataTemplate></ListBox.ItemTemplate>
      </ListBox>

     </Grid>
      <Border Grid.Column="1" Grid.RowSpan="2" Width="300" Margin="20,0,0,0" Background="{StaticResource Surface}" CornerRadius="18" Padding="22" Visibility="{Binding HasSelectedSong, Converter={StaticResource BoolVisibility}}">
       <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
        <TextBlock Text="SELECTED SOUND" Foreground="{StaticResource Accent}" FontSize="11"/><TextBlock Text="{Binding SelectedSong.SongName}" FontSize="24" FontWeight="SemiBold" Margin="0,12,0,4"/><TextBlock Text="{Binding SelectedSong.Artist}" Foreground="{StaticResource Muted}"/>
        <TextBlock Text="{Binding SelectedSong.LinkedAssetIdDisplay}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,18,0,18"/>
        <StackPanel Visibility="{Binding NeedsTargetId, Converter={StaticResource BoolVisibility}}"><TextBlock Text="Roblox sound ID to replace"/><TextBox Text="{Binding TargetAssetId, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Roblox sound ID to replace" Margin="0,6,0,12"/></StackPanel>
        <Button Content="{Binding SongToggleLabel}" Command="{Binding ToggleSelectedSongCommand}" Style="{StaticResource Primary}" Margin="0,0,0,8"/>
        <Button Content="Store for later" Command="{Binding StoreSelectedSongCommand}" Margin="0,0,0,8"/>
        <Button Content="Preview" Command="{Binding PreviewSongCommand}" Margin="0,0,0,8"/>
        <Button Content="Remove from Stored" Command="{Binding RemoveSelectedSongCommand}" Visibility="{Binding SelectedSongStored, Converter={StaticResource BoolVisibility}}"/>
       </StackPanel></ScrollViewer>
      </Border>
    </Grid>
   </TabItem>
   <TabItem Header="Stored">
    <Grid Margin="0,28,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,22"><Button DockPanel.Dock="Right" Content="+ Local audio" Command="{Binding AddLocalAudioCommand}" Style="{StaticResource Primary}"/><StackPanel><TextBlock Text="Your sounds." FontSize="32" FontWeight="SemiBold"/><TextBlock Text="Enabled sounds replace automatically. Disable to bring back the original." Foreground="{StaticResource Muted}" Margin="0,6,18,0"/></StackPanel></DockPanel>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBox Text="{Binding StoredQuery, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Filter stored sounds" ToolTip="Filter your stored sounds" Margin="0,0,0,14"/>
       <TextBlock Grid.Row="1" Text="Your library starts here.&#10;Store a search result or add local audio." TextAlignment="Center" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Visibility="{Binding LibraryEmpty, Converter={StaticResource BoolVisibility}}"/>
       <ListBox Grid.Row="1" ItemsSource="{Binding VisibleRules}" SelectedItem="{Binding SelectedRule}" AutomationProperties.Name="Stored sounds"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding AutomationStatus}" Foreground="{StaticResource Accent}" Margin="0,7,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
      </Grid>
      <Border Grid.Column="1" Width="320" Margin="20,0,0,0" Padding="22" Background="{StaticResource Surface}" CornerRadius="18" Visibility="{Binding HasSelectedRule, Converter={StaticResource BoolVisibility}}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
       <TextBlock Text="{Binding SelectedRule.Name}" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedRule.AutomationStatus}" Foreground="{StaticResource Accent}" Margin="0,8,0,20"/>
       <Button Content="{Binding RuleToggleLabel}" Command="{Binding ToggleSelectedRuleCommand}" Style="{StaticResource Primary}" Margin="0,0,0,10"/><Button Content="Remove from Stored" Command="{Binding RemoveSelectedRuleCommand}"/>
       <Expander Header="Edit sound details" Foreground="#EDF3FA" Margin="0,24,0,0" ><Expander.Style><Style TargetType="Expander"><Setter Property="IsExpanded" Value="False"/><Style.Triggers><DataTrigger Binding="{Binding SelectedRule.AssetIdPattern}" Value=""><Setter Property="IsExpanded" Value="True"/></DataTrigger></Style.Triggers></Style></Expander.Style><StackPanel Margin="0,14,0,0">
        <TextBlock Text="Name"/><TextBox Text="{Binding EditorName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Sound name" Margin="0,6,0,12"/>
        <TextBlock Text="Roblox sound ID to replace"/><TextBox Text="{Binding EditorAssetId, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Stored Roblox sound ID" Margin="0,6,0,12"/>
        <TextBlock Text="Audio file, URL, or song code"/><TextBox Text="{Binding EditorSource, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Replacement audio source" Margin="0,6,0,12"/>
        <Button Content="Save details" Command="{Binding SaveDetailsCommand}"/>
       </StackPanel></Expander>
      </StackPanel></ScrollViewer></Border>
     </Grid>
    </Grid>
   </TabItem>
  </TabControl>
  <Border Grid.Row="2" BorderBrush="#29323D" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,18,0,0">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="{Binding Status}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,20,8"/><StackPanel Orientation="Horizontal"><Button Content="{Binding UpdateStatus}" Command="{Binding CheckForUpdatesCommand}" FontSize="11" Padding="0" Background="Transparent" Foreground="{StaticResource Muted}"/><Button Content="Restart to update" Command="{Binding RestartForUpdateCommand}" Visibility="{Binding UpdateReady, Converter={StaticResource BoolVisibility}}" FontSize="11" Padding="10,4" Margin="12,0,0,0"/></StackPanel></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Stop preview" Command="{Binding StopPreviewCommand}" FontSize="12" Padding="10,8" Margin="0,0,8,0"/><Button Content="Share audio &#x2197;" Command="{Binding OpenIndexCommand}" FontSize="12" Padding="10,8"/></StackPanel>
   </Grid>
  </Border>
  <MediaElement x:Name="PreviewPlayer" Source="{Binding PreviewAudioSource}" LoadedBehavior="Play" UnloadedBehavior="Stop" Visibility="Collapsed" MediaFailed="PreviewPlayer_OnMediaFailed"/>
 </Grid>
</Window>
