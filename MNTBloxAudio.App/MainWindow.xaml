<Window x:Class="MNTBloxAudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:core="clr-namespace:MNTBloxAudio.Core.Models;assembly=MNTBloxAudio.Core"
        mc:Ignorable="d"
        Title="MNTBloxAudio"
        Width="1280"
        Height="860"
        MinWidth="980"
        MinHeight="680"
        Background="{StaticResource WindowBrush}"
        FontFamily="Segoe UI Variable Text"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <MediaElement x:Name="PreviewPlayer"
                      Width="0"
                      Height="0"
                      Opacity="0"
                      LoadedBehavior="Play"
                      UnloadedBehavior="Stop"
                      Source="{Binding PreviewAudioSource}"
                      MediaOpened="PreviewPlayer_OnMediaOpened"
                      MediaEnded="PreviewPlayer_OnMediaEnded"
                      MediaFailed="PreviewPlayer_OnMediaFailed" />

        <StackPanel Grid.Row="0">
            <TextBlock FontFamily="Segoe UI Variable Display"
                       FontSize="46"
                       FontWeight="Light"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="MINTILER'S ROBLOX AUDIO REPLACER"
                       TextWrapping="Wrap"
                       TextOptions.TextFormattingMode="Display" />
            <TextBlock Margin="2,10,0,0"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="Shape local replacements, keep an eye on each audio's status, and manage uploads or index results from the same dashboard."
                       TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1"
              Margin="0,18,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="0,0,12,0"
                    Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionLabelTextStyle}"
                               Text="Roblox Sessions" />
                    <TextBlock Margin="0,8,0,0"
                               Style="{StaticResource MetricValueTextStyle}"
                               Text="{Binding RobloxSessionCount}" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="{Binding SessionStatusText}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Margin="0,0,12,0"
                    Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionLabelTextStyle}"
                               Text="Configured Audio" />
                    <TextBlock Margin="0,8,0,0"
                               Style="{StaticResource MetricValueTextStyle}"
                               Text="{Binding RuleCount}" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="Rules currently tracked in My Audio" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Margin="0,0,12,0"
                    Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionLabelTextStyle}"
                               Text="Replacement Mode" />
                    <TextBlock Margin="0,8,0,0"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Text="{Binding ReplacementModeText}" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="{Binding RobloxMuteStatus}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="3"
                    Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionLabelTextStyle}"
                               Text="Preview" />
                    <TextBlock Margin="0,8,0,0"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Text="{Binding PreviewHeading}" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="{Binding PreviewStatusText}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <TabControl Grid.Row="2">
            <TabItem Header="MY AUDIO">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.65*" />
                        <ColumnDefinition Width="0.95*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Margin="0,0,18,0"
                            Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <DockPanel LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock FontFamily="Segoe UI Variable Display"
                                               FontSize="22"
                                               FontWeight="Light"
                                               Text="MY AUDIO" />
                                    <TextBlock Margin="0,6,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="Every rule gets a status badge so it is easy to see what is ready, missing a source, or disabled."
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <WrapPanel DockPanel.Dock="Right"
                                           HorizontalAlignment="Right">
                                    <Button Style="{StaticResource SubtleButtonStyle}"
                                            Content="Add"
                                            Command="{Binding AddRuleCommand}" />
                                    <Button Style="{StaticResource SubtleButtonStyle}"
                                            Content="Apply All"
                                            Command="{Binding ApplyAllRulesCommand}" />
                                    <Button Style="{StaticResource SubtleButtonStyle}"
                                            Content="Remove"
                                            Command="{Binding RemoveSelectedRuleCommand}" />
                                    <Button Style="{StaticResource SubtleButtonStyle}"
                                            Content="Reset + Refresh"
                                            Command="{Binding RefreshCommand}" />
                                </WrapPanel>
                            </DockPanel>

                            <Border Grid.Row="1"
                                    Margin="0,18,0,16"
                                    Padding="14"
                                    CornerRadius="10"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1">
                                <TextBlock Foreground="{StaticResource MutedTextBrush}"
                                           Text="Tip: select a card to edit it on the right. The card subtitle tells you whether the source is local, remote, or a 6-letter index code."
                                           TextWrapping="Wrap" />
                            </Border>

                            <ListBox Grid.Row="2"
                                     ItemsSource="{Binding Rules}"
                                     SelectedItem="{Binding SelectedRule}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type core:ReplacementRule}">
                                        <Border Style="{StaticResource AudioCardBorderStyle}">
                                            <StackPanel>
                                                <DockPanel LastChildFill="False">
                                                    <Border DockPanel.Dock="Right"
                                                            Tag="{Binding StatusTone}"
                                                            Style="{StaticResource StatusBadgeBorderStyle}">
                                                        <TextBlock Tag="{Binding StatusTone}"
                                                                   Style="{StaticResource StatusBadgeTextStyle}"
                                                                   Text="{Binding StatusDisplay}" />
                                                    </Border>
                                                    <TextBlock FontSize="18"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding Name}"
                                                               TextWrapping="Wrap" />
                                                </DockPanel>
                                                <TextBlock Margin="0,6,0,0"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           Text="{Binding SourceTypeDisplay}" />
                                                <TextBlock Margin="0,18,0,0"
                                                           FontSize="17"
                                                           Text="{Binding AssetIdPattern, StringFormat=Target asset {0}}" />
                                                <TextBlock Margin="0,4,0,0"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           Text="{Binding FileNameDisplay}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Margin="0,10,0,0"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           Text="{Binding StatusDetailDisplay}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Margin="0,12,0,0"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           Text="{Binding SourceAssetSizeDisplay, StringFormat=Roblox cache {0}}" />
                                                <TextBlock Margin="0,2,0,0"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           Text="{Binding ReplacementFileSizeDisplay, StringFormat=Replacement {0}}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1"
                            Style="{StaticResource CardBorderStyle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <DockPanel LastChildFill="False">
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock FontFamily="Segoe UI Variable Display"
                                                   FontSize="22"
                                                   FontWeight="Light"
                                                   Text="EDIT" />
                                        <TextBlock Margin="0,6,0,0"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Text="Tune the selected audio, preview it, and save once to prepare or apply it."
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Border DockPanel.Dock="Right"
                                            Tag="{Binding SelectedRule.StatusTone}"
                                            Style="{StaticResource StatusBadgeBorderStyle}">
                                        <TextBlock Tag="{Binding SelectedRule.StatusTone}"
                                                   Style="{StaticResource StatusBadgeTextStyle}"
                                                   Text="{Binding SelectedRule.StatusDisplay, TargetNullValue=No Selection}" />
                                    </Border>
                                </DockPanel>

                                <Border Margin="0,18,0,18"
                                        Padding="16"
                                        CornerRadius="12"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource CardBorderBrush}"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock FontSize="20"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding SelectedRule.Name, TargetNullValue=Choose an audio card}" />
                                        <TextBlock Margin="0,6,0,0"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Text="{Binding SelectedRule.StatusDetailDisplay, TargetNullValue=Pick a rule on the left to begin editing.}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Style="{StaticResource SectionLabelTextStyle}"
                                           Text="Name" />
                                <TextBox Text="{Binding SelectedRule.Name, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Style="{StaticResource SectionLabelTextStyle}"
                                           Text="Exact Roblox asset ID" />
                                <TextBox Text="{Binding SelectedRule.AssetIdPattern, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Style="{StaticResource SectionLabelTextStyle}"
                                           Text="Replacement file, direct URL, or 6-letter code" />
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right"
                                            Margin="12,0,0,0"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            Content="Browse File"
                                            Command="{Binding BrowseSelectedRuleCommand}" />
                                    <TextBox Text="{Binding SelectedRule.FilePath, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>

                                <CheckBox Margin="0,8,0,6"
                                          IsChecked="{Binding SelectedRule.IsEnabled}"
                                          Content="Enable replacement for this audio" />

                                <UniformGrid Margin="0,12,0,16"
                                             Columns="2">
                                    <Border Margin="0,0,8,0"
                                            Padding="14"
                                            CornerRadius="12"
                                            Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource CardBorderBrush}"
                                            BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionLabelTextStyle}"
                                                       Text="Roblox Source" />
                                            <TextBlock Margin="0,6,0,0"
                                                       FontSize="20"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding SelectedRule.SourceAssetSizeDisplay, Mode=OneWay}" />
                                            <TextBlock Margin="0,6,0,0"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       Text="{Binding SelectedRule.AssetIdPattern, StringFormat=Asset {0}}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Margin="8,0,0,0"
                                            Padding="14"
                                            CornerRadius="12"
                                            Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource CardBorderBrush}"
                                            BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionLabelTextStyle}"
                                                       Text="Replacement Source" />
                                            <TextBlock Margin="0,6,0,0"
                                                       FontSize="20"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding SelectedRule.ReplacementFileSizeDisplay, Mode=OneWay}" />
                                            <TextBlock Margin="0,6,0,0"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       Text="{Binding SelectedRule.FileNameDisplay, Mode=OneWay}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Margin="0,4,0,0"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       Text="{Binding SelectedRule.ReplacementSourceNoteDisplay, Mode=OneWay}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <WrapPanel>
                                    <Button Style="{StaticResource SubtleButtonStyle}"
                                            Content="Preview Rule"
                                            Command="{Binding PlaySelectedRuleCommand}" />
                                    <Button Style="{StaticResource SubtleButtonStyle}"
                                            Content="Stop Rule Preview"
                                            Command="{Binding StopRulePreviewCommand}" />
                                    <Button Content="Save + Apply Rule"
                                            Command="{Binding SaveAndApplySelectedRuleCommand}" />
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="UPLOADING">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="0.95*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Margin="0,0,18,0"
                            Style="{StaticResource CardBorderStyle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock FontFamily="Segoe UI Variable Display"
                                           FontSize="22"
                                           FontWeight="Light"
                                           Text="UPLOADING" />
                                <TextBlock Margin="0,6,0,18"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="Submit a linked Roblox sound plus metadata to the index API, then verify the result from the cards on the right."
                                           TextWrapping="Wrap" />

                                <Border Padding="14"
                                        CornerRadius="12"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource CardBorderBrush}"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionLabelTextStyle}"
                                                   Text="Device ID" />
                                        <DockPanel Margin="0,6,0,0"
                                                   LastChildFill="True">
                                            <Button DockPanel.Dock="Right"
                                                    Margin="12,0,0,0"
                                                    Style="{StaticResource SubtleButtonStyle}"
                                                    Content="Copy"
                                                    Command="{Binding CopyDeviceIdCommand}" />
                                            <TextBox Text="{Binding DeviceId}"
                                                     IsReadOnly="True" />
                                        </DockPanel>

                                        <TextBlock Margin="0,4,0,0"
                                                   Style="{StaticResource SectionLabelTextStyle}"
                                                   Text="Song index base URL" />
                                        <TextBox Margin="0,6,0,0"
                                                 Text="{Binding SongIndexBaseUrl, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Margin="0,18,0,0"
                                           Style="{StaticResource SectionLabelTextStyle}"
                                           Text="Source Roblox sound ID" />
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right"
                                            Margin="12,0,0,0"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            Content="Autofill"
                                            Command="{Binding AutofillUploadFromRobloxSoundIdCommand}" />
                                    <TextBox Text="{Binding UploadRobloxSoundId, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>

                                <TextBlock Style="{StaticResource SectionLabelTextStyle}"
                                           Text="Linked Roblox sound ID to replace" />
                                <TextBox Text="{Binding UploadLinkedAssetId, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Style="{StaticResource SectionLabelTextStyle}"
                                           Text="Direct audio URL" />
                                <TextBox Text="{Binding UploadAudioUrl, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Style="{StaticResource SectionLabelTextStyle}"
                                           Text="Song name" />
                                <TextBox Text="{Binding UploadSongName, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Style="{StaticResource SectionLabelTextStyle}"
                                           Text="Artist" />
                                <TextBox Text="{Binding UploadArtist, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Style="{StaticResource SectionLabelTextStyle}"
                                           Text="Uploader name" />
                                <TextBox Text="{Binding UploadUploaderName, UpdateSourceTrigger=PropertyChanged}" />

                                <Border Margin="0,8,0,16"
                                        Padding="14"
                                        CornerRadius="12"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource CardBorderBrush}"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionLabelTextStyle}"
                                                   Text="Submission Status" />
                                        <TextBlock Margin="0,8,0,0"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Text="{Binding UploadStatusText}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <WrapPanel>
                                    <Button Style="{StaticResource SubtleButtonStyle}"
                                            Content="Preview Typed URL"
                                            Command="{Binding PreviewTypedAudioCommand}" />
                                    <Button Content="Submit Link"
                                            Command="{Binding UploadAudioCommand}" />
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Column="1"
                            Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock FontFamily="Segoe UI Variable Display"
                                           FontSize="22"
                                           FontWeight="Light"
                                           Text="MY SUBMISSIONS" />
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="Each uploaded audio shows whether it is linked back to a Roblox sound and whether the direct audio URL still looks playable."
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <ListBox Grid.Row="1"
                                     Margin="0,18,0,18"
                                     ItemsSource="{Binding UploadedSongs}"
                                     SelectedItem="{Binding SelectedUploadedSong}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type core:UploadedSongRecord}">
                                        <Border Style="{StaticResource AudioCardBorderStyle}"
                                                Width="Auto">
                                            <StackPanel>
                                                <DockPanel LastChildFill="False">
                                                    <Border DockPanel.Dock="Right"
                                                            Tag="{Binding StatusTone}"
                                                            Style="{StaticResource StatusBadgeBorderStyle}">
                                                        <TextBlock Tag="{Binding StatusTone}"
                                                                   Style="{StaticResource StatusBadgeTextStyle}"
                                                                   Text="{Binding StatusDisplay}" />
                                                    </Border>
                                                    <TextBlock FontSize="17"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding SummaryDisplay}"
                                                               TextWrapping="Wrap" />
                                                </DockPanel>
                                                <TextBlock Margin="0,6,0,0"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           Text="{Binding Code, StringFormat=Code {0}}" />
                                                <TextBlock Margin="0,4,0,0"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           Text="{Binding LinkedAssetIdDisplay}" />
                                                <TextBlock Margin="0,4,0,0"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           Text="{Binding UploaderDisplay}" />
                                                <TextBlock Margin="0,4,0,0"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           Text="{Binding UploadedAtDisplay}" />
                                                <TextBlock Margin="0,8,0,0"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           Text="{Binding AudioUrl}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border Grid.Row="2"
                                    Padding="14"
                                    CornerRadius="12"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Left">
                                            <TextBlock FontSize="18"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding SelectedUploadedSong.SummaryDisplay, TargetNullValue=No upload selected}" />
                                            <TextBlock Margin="0,4,0,0"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       Text="{Binding PreviewStatusText}" />
                                        </StackPanel>
                                        <Border DockPanel.Dock="Right"
                                                Tag="{Binding SelectedUploadedSong.StatusTone}"
                                                Style="{StaticResource StatusBadgeBorderStyle}">
                                            <TextBlock Tag="{Binding SelectedUploadedSong.StatusTone}"
                                                       Style="{StaticResource StatusBadgeTextStyle}"
                                                       Text="{Binding SelectedUploadedSong.StatusDisplay, TargetNullValue=Select One}" />
                                        </Border>
                                    </DockPanel>

                                    <WrapPanel Margin="0,14,0,0">
                                        <Button Style="{StaticResource SubtleButtonStyle}"
                                                Content="Play Selected Upload"
                                                Command="{Binding PreviewSelectedUploadCommand}" />
                                        <Button Style="{StaticResource SubtleButtonStyle}"
                                                Content="Stop Preview"
                                                Command="{Binding StopPreviewCommand}" />
                                        <Button Content="Delete Selected Upload"
                                                Command="{Binding DeleteSelectedUploadCommand}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="SONG INDEX">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="0.95*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Margin="0,0,18,0"
                            Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock FontFamily="Segoe UI Variable Display"
                                           FontSize="22"
                                           FontWeight="Light"
                                           Text="SONG INDEX" />
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="Search the public index and scan each result's card for linked Roblox IDs, playable audio, and upload details."
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <Border Grid.Row="1"
                                    Margin="0,18,0,14"
                                    Padding="12"
                                    CornerRadius="12"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1">
                                <DockPanel LastChildFill="True">
                                    <WrapPanel DockPanel.Dock="Right"
                                               Margin="12,0,0,0">
                                        <Button Style="{StaticResource SubtleButtonStyle}"
                                                Content="All Songs"
                                                Command="{Binding LoadAllSongsCommand}" />
                                        <Button Content="Search"
                                                Command="{Binding SearchSongsCommand}" />
                                    </WrapPanel>
                                    <TextBox Margin="0"
                                             Text="{Binding SongSearchQuery, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                            </Border>

                            <Border Grid.Row="2"
                                    Margin="0,0,0,14"
                                    Padding="12"
                                    CornerRadius="12"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1">
                                <TextBlock Foreground="{StaticResource MutedTextBrush}"
                                           Text="{Binding SongSearchStatusText}"
                                           TextWrapping="Wrap" />
                            </Border>

                            <ListBox Grid.Row="3"
                                     ItemsSource="{Binding SongSearchResults}"
                                     SelectedItem="{Binding SelectedSongSearchResult}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type core:SongIndexEntry}">
                                        <Border Style="{StaticResource AudioCardBorderStyle}"
                                                Width="Auto">
                                            <StackPanel>
                                                <DockPanel LastChildFill="False">
                                                    <Border DockPanel.Dock="Right"
                                                            Tag="{Binding StatusTone}"
                                                            Style="{StaticResource StatusBadgeBorderStyle}">
                                                        <TextBlock Tag="{Binding StatusTone}"
                                                                   Style="{StaticResource StatusBadgeTextStyle}"
                                                                   Text="{Binding StatusDisplay}" />
                                                    </Border>
                                                    <TextBlock FontSize="17"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding SongName}"
                                                               TextWrapping="Wrap" />
                                                </DockPanel>
                                                <TextBlock Margin="0,6,0,0"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           Text="{Binding Artist}" />
                                                <TextBlock Margin="0,6,0,0"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           Text="{Binding Code, StringFormat=Code {0}}" />
                                                <TextBlock Margin="0,4,0,0"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           Text="{Binding LinkedAssetIdDisplay}" />
                                                <TextBlock Margin="0,4,0,0"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           Text="{Binding UploaderDisplay}" />
                                                <TextBlock Margin="0,4,0,0"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           Text="{Binding UploadedAtDisplay}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1"
                            Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <DockPanel LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock FontFamily="Segoe UI Variable Display"
                                               FontSize="22"
                                               FontWeight="Light"
                                               Text="SELECTED SONG" />
                                    <TextBlock Margin="0,6,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="Preview the selected song, copy its code, or drop it straight into the selected rule."
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <Border DockPanel.Dock="Right"
                                        Tag="{Binding SelectedSongSearchResult.StatusTone}"
                                        Style="{StaticResource StatusBadgeBorderStyle}">
                                    <TextBlock Tag="{Binding SelectedSongSearchResult.StatusTone}"
                                               Style="{StaticResource StatusBadgeTextStyle}"
                                               Text="{Binding SelectedSongSearchResult.StatusDisplay, TargetNullValue=Select One}" />
                                </Border>
                            </DockPanel>

                            <Border Grid.Row="1"
                                    Margin="0,18,0,14"
                                    Padding="14"
                                    CornerRadius="12"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock FontSize="20"
                                               FontWeight="SemiBold"
                                               Text="{Binding SelectedSongSearchResult.SongName, TargetNullValue=No song selected}" />
                                    <TextBlock Margin="0,6,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="{Binding SelectedSongSearchResult.Artist, TargetNullValue=Run a search or load all songs to populate the index.}" />
                                    <TextBlock Margin="0,8,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="{Binding SelectedSongSearchResult.Code, StringFormat=Code {0}}" />
                                    <TextBlock Margin="0,4,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="{Binding SelectedSongSearchResult.LinkedAssetIdDisplay}" />
                                    <TextBlock Margin="0,4,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="{Binding SelectedSongSearchResult.UploaderDisplay}" />
                                    <TextBlock Margin="0,4,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="{Binding SelectedSongSearchResult.UploadedAtDisplay}" />
                                    <TextBlock Margin="0,10,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="{Binding SelectedSongSearchResult.AudioUrl}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2"
                                    Margin="0,0,0,14"
                                    Padding="14"
                                    CornerRadius="12"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock FontSize="18"
                                               FontWeight="SemiBold"
                                               Text="{Binding PreviewHeading}" />
                                    <TextBlock Margin="0,4,0,10"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="{Binding PreviewStatusText}"
                                               TextWrapping="Wrap" />
                                    <WrapPanel>
                                        <Button Style="{StaticResource SubtleButtonStyle}"
                                                Content="Play Song"
                                                Command="{Binding PreviewSelectedSongSearchResultCommand}" />
                                        <Button Style="{StaticResource SubtleButtonStyle}"
                                                Content="Copy Code"
                                                Command="{Binding CopySelectedSongCodeCommand}" />
                                        <Button Style="{StaticResource SubtleButtonStyle}"
                                                Content="Stop Preview"
                                                Command="{Binding StopPreviewCommand}" />
                                        <Button Content="Use Code In Rule"
                                                Command="{Binding UseSelectedSongCodeCommand}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Grid.Row="3"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="Tip: when an index entry already has a linked Roblox sound ID, using its code in a rule fills in both the source reference and the target asset automatically."
                                       TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="ADVANCED">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1.05*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Margin="0,0,0,18"
                            Style="{StaticResource CardBorderStyle}">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock FontFamily="Segoe UI Variable Display"
                                           FontSize="22"
                                           FontWeight="Light"
                                           Text="ADVANCED" />
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="Background checks, cache inspection, and activity logs stay here."
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <WrapPanel DockPanel.Dock="Right"
                                       HorizontalAlignment="Right">
                                <CheckBox VerticalAlignment="Center"
                                          IsChecked="{Binding UseDarkMode}"
                                          Content="Dark mode" />
                                <CheckBox VerticalAlignment="Center"
                                          IsChecked="{Binding AutoApplyCacheReplacements}"
                                          Content="Auto-apply on re-fetch" />
                                <Button Style="{StaticResource SubtleButtonStyle}"
                                        Content="Apply All"
                                        Command="{Binding ApplyAllRulesCommand}" />
                                <Button Style="{StaticResource SubtleButtonStyle}"
                                        Content="Prepare Enabled"
                                        Command="{Binding PrepareRuleAssetsCommand}" />
                                <Button Style="{StaticResource SubtleButtonStyle}"
                                        Content="Reset + Refresh"
                                        Command="{Binding RefreshCommand}" />
                                <Button Content="Save"
                                        Command="{Binding SaveConfigurationCommand}" />
                            </WrapPanel>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1"
                            Margin="0,0,0,18"
                            Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock FontSize="18"
                                       FontWeight="SemiBold"
                                       Text="Cached Sounds" />

                            <DataGrid Grid.Row="1"
                                      Margin="0,14,0,0"
                                      ItemsSource="{Binding CachedSoundFiles}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      GridLinesVisibility="Horizontal"
                                      BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="File"
                                                        Binding="{Binding FileName}"
                                                        Width="1.5*" />
                                    <DataGridTextColumn Header="Cache KB"
                                                        Binding="{Binding LengthDisplay}"
                                                        Width="100" />
                                    <DataGridTextColumn Header="Asset ID"
                                                        Binding="{Binding MatchedAssetId}"
                                                        Width="120" />
                                    <DataGridTextColumn Header="Rule"
                                                        Binding="{Binding MatchedRuleName}"
                                                        Width="1.1*" />
                                    <DataGridTextColumn Header="State"
                                                        Binding="{Binding StatusText}"
                                                        Width="120" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock FontSize="18"
                                       FontWeight="SemiBold"
                                       Text="Activity" />

                            <ListBox Grid.Row="1"
                                     Margin="0,14,0,0"
                                     ItemsSource="{Binding Activity}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type core:ActivityLogEntry}">
                                        <Border Margin="0,0,0,8"
                                                Padding="12"
                                                CornerRadius="12"
                                                Background="{StaticResource SurfaceAltBrush}"
                                                BorderBrush="{StaticResource CardBorderBrush}"
                                                BorderThickness="1">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding Category}" />
                                                <TextBlock DockPanel.Dock="Right"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           Text="{Binding Timestamp, StringFormat={}{0:hh:mm:ss tt}}" />
                                                <TextBlock Margin="0,22,0,0"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           Text="{Binding Message}"
                                                           TextWrapping="Wrap" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
